rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Assumed data model: users/{uid}/{bucket}/{documentId}. Every app record is
    // owned by the Firebase Auth UID in its path. IDs and field sizes are
    // validated below; photos are individual documents to stay below 1 MiB.
    // Buckets: items, subjectFolders, completed, memoFolders, memos, memoPhotos,
    // settings (one `settings` document), and metadata (one migration document).
    // The sole global document, system/legacyImportOwner, assigns legacy local
    // data to the verified application owner account once.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        (('uid' in resource.data) && request.resource.data.uid == resource.data.uid);
    }

    function validId(data, documentId) {
      return data.keys().hasAll(['id']) && data.id is string &&
        data.id.size() > 0 && data.id.size() <= 180 && data.id == documentId;
    }

    function optionalString(data, key, maxLength) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLength);
    }

    function createdAtUnchanged() {
      return !('createdAt' in resource.data) ||
        (('createdAt' in request.resource.data) && request.resource.data.createdAt == resource.data.createdAt);
    }

    function validItem(data, documentId) {
      return data.keys().hasOnly(['id', 'title', 'category', 'date', 'time', 'end', 'reminder', 'repeat', 'skipHolidays', 'subjectId', 'note']) &&
        data.keys().hasAll(['id', 'title', 'category', 'date', 'time', 'end', 'reminder', 'repeat', 'note']) &&
        validId(data, documentId) && data.title is string && data.title.size() > 0 && data.title.size() <= 60 &&
        data.category in ['study', 'leisure', 'life', 'task'] && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.time is string && data.time.size() <= 5 && data.end is string && data.end.size() <= 5 &&
        data.reminder is string && data.reminder.size() <= 32 && data.repeat in ['none', 'daily', 'weekly', 'monthly'] &&
        data.note is string && data.note.size() <= 180 && optionalString(data, 'subjectId', 180) &&
        (!('skipHolidays' in data) || data.skipHolidays is bool);
    }

    function validSubjectFolder(data, documentId) {
      return data.keys().hasOnly(['id', 'name', 'color']) && data.keys().hasAll(['id', 'name', 'color']) &&
        validId(data, documentId) && data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.color is string && data.color.size() <= 20;
    }

    function validMemoFolder(data, documentId) {
      return data.keys().hasOnly(['id', 'name', 'createdAt']) && data.keys().hasAll(['id', 'name']) &&
        validId(data, documentId) && data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        optionalString(data, 'createdAt', 40);
    }

    function validMemo(data, documentId) {
      return data.keys().hasOnly(['id', 'folderId', 'title', 'body', 'createdAt', 'updatedAt']) &&
        data.keys().hasAll(['id', 'folderId', 'title', 'body']) && validId(data, documentId) &&
        data.folderId is string && data.folderId.size() > 0 && data.folderId.size() <= 180 &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 80 &&
        data.body is string && data.body.size() <= 10000 && optionalString(data, 'createdAt', 40) &&
        optionalString(data, 'updatedAt', 40);
    }

    function validMemoPhoto(data, documentId) {
      return data.keys().hasOnly(['id', 'memoId', 'index', 'imageData']) &&
        data.keys().hasAll(['id', 'memoId', 'index', 'imageData']) && validId(data, documentId) &&
        data.memoId is string && data.memoId.size() > 0 && data.memoId.size() <= 180 &&
        data.index is int && data.index >= 0 && data.index <= 5 &&
        data.imageData is string && data.imageData.size() > 0 && data.imageData.size() <= 980000 &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/memos/$(data.memoId));
    }

    function validCompleted(data, documentId) {
      return data.keys().hasOnly(['id', 'value']) && data.keys().hasAll(['id', 'value']) &&
        validId(data, documentId) && data.value is bool;
    }

    function validSettings(data, documentId) {
      return data.keys().hasOnly(['id', 'value']) && data.keys().hasAll(['id', 'value']) &&
        validId(data, documentId) && data.id == 'settings' && data.value is map &&
        data.value.keys().hasOnly(['timeZone', 'location', 'theme', 'accent', 'fontScale', 'reminderLeadMinutes']) &&
        data.value.keys().hasAll(['timeZone', 'location', 'theme', 'accent', 'fontScale', 'reminderLeadMinutes']) &&
        data.value.timeZone is string && data.value.timeZone.size() > 0 && data.value.timeZone.size() <= 64 &&
        data.value.location is string && data.value.location.size() <= 100 &&
        data.value.theme in ['light', 'dark'] && data.value.accent in ['purple', 'blue', 'green', 'rose'] &&
        data.value.fontScale is number && data.value.fontScale >= 75 && data.value.fontScale <= 150 &&
        data.value.reminderLeadMinutes is number && data.value.reminderLeadMinutes >= 0 && data.value.reminderLeadMinutes <= 1440;
    }

    function validMetadata(data, documentId) {
      return documentId == 'migration' && data.keys().hasOnly(['legacyImported', 'importedAt']) &&
        data.keys().hasAll(['legacyImported', 'importedAt']) && data.legacyImported is bool &&
        data.legacyImported == true && data.importedAt is timestamp;
    }

    function validRecord(bucket, data, documentId) {
      return (bucket == 'items' && validItem(data, documentId)) ||
        (bucket == 'subjectFolders' && validSubjectFolder(data, documentId)) ||
        (bucket == 'memoFolders' && validMemoFolder(data, documentId)) ||
        (bucket == 'memos' && validMemo(data, documentId)) ||
        (bucket == 'memoPhotos' && validMemoPhoto(data, documentId)) ||
        (bucket == 'completed' && validCompleted(data, documentId)) ||
        (bucket == 'settings' && validSettings(data, documentId)) ||
        (bucket == 'metadata' && validMetadata(data, documentId));
    }

    function legacyOwnerAccount() {
      return isAuthenticated() && request.auth.token.email == 'liu0916207081@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    match /users/{uid}/{bucket}/{documentId} {
      allow get, list: if isOwner(uid) && bucket in [
        'items', 'subjectFolders', 'completed', 'memoFolders', 'memos', 'memoPhotos', 'settings', 'metadata'
      ];
      allow create: if isOwner(uid) && uidUnchanged() && validRecord(bucket, request.resource.data, documentId);
      allow update: if isOwner(uid) && bucket != 'metadata' && uidNotModified() && createdAtUnchanged() &&
        validRecord(bucket, request.resource.data, documentId);
      allow delete: if isOwner(uid) && bucket in [
        'items', 'subjectFolders', 'completed', 'memoFolders', 'memos', 'memoPhotos'
      ];
    }

    match /system/legacyImportOwner {
      allow get: if legacyOwnerAccount();
      allow list: if false;
      allow create: if legacyOwnerAccount() && request.resource.data.keys().hasOnly(['uid', 'claimedAt']) &&
        request.resource.data.keys().hasAll(['uid', 'claimedAt']) && request.resource.data.uid == request.auth.uid &&
        request.resource.data.claimedAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
